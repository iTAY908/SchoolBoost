# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Infobip (WhatsApp Business API) ---
# Base URL from the Infobip portal, without https://
INFOBIP_BASE_URL=8vn9v1.api.infobip.com
# API key from the Infobip portal. Rotate it if it has ever been pasted in chat.
INFOBIP_API_KEY=
# The WhatsApp Business sender number, digits only, no leading +
INFOBIP_SENDER=447860088970
# Approved template used to open a conversation outside the 24h window
INFOBIP_TEMPLATE_NAME=test_whatsapp_template_en
INFOBIP_TEMPLATE_LANGUAGE=en

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Server ---
PORT=3000
# Random secret. Infobip is configured to call /webhook/whatsapp?token=<this>
WEBHOOK_TOKEN=
# Conversation turns kept per contact
HISTORY_TURNS=20
