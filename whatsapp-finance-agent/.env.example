# ===== Anthropic (Claude AI) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== WhatsApp Cloud API (Meta) =====
# טוקן גישה מ-Meta for Developers
WHATSAPP_TOKEN=EAAG...
# מזהה מספר הטלפון (Phone Number ID) מלוח הבקרה של Meta
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# מחרוזת סודית שאתה בוחר - חייבת להתאים למה שמגדירים ב-Webhook של Meta
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token

# ===== Google Sheets =====
# מזהה הגיליון (מה-URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=1AbC...
# נתיב לקובץ ה-JSON של חשבון השירות (Service Account)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# לחלופין: תוכן ה-JSON עצמו (שימושי בפריסה בענן, למשל Railway/Render)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ===== שרת =====
PORT=3000
