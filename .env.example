# Copy to .env and fill in. .env is gitignored — never commit real values.
# If a token has ever been pasted into a chat, an issue, or a log, rotate it
# in the Green API console before using it here.

# From the Green API console.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# Regional host for your instance, shown next to the instance id in the
# console. Instances numbered 7107xxxxxx use https://7107.api.greenapi.com
GREEN_API_BASE_URL=https://api.green-api.com

# Shared secret for incoming webhooks. Set the same value in the console
# under "Outgoing webhook token". Requests without it are rejected with 401.
GREEN_API_WEBHOOK_TOKEN=

# Local server port.
PORT=3000

# Country code used to expand local numbers (0501234567 -> 972501234567).
DEFAULT_COUNTRY_CODE=972
