# העתק לקובץ .env ומלא את הערכים (הקובץ .env לא נכנס ל-git)

# הטוקן מ-@BotFather. חובה.
TELEGRAM_BOT_TOKEN=

# אזור זמן לחישוב תאריכים, תזכורות והסיכום היומי
TZ_NAME=Asia/Jerusalem

# היכן נשמר קובץ הנתונים
DATA_FILE=./data/schoolboost.json

# רמת לוג: debug | info | warn | error
LOG_LEVEL=info

# לשימוש מתקדם בלבד (בדיקות / Bot API server עצמאי)
# TELEGRAM_API_BASE=https://api.telegram.org
