# העתק לקובץ .env ומלא את הערכים (הקובץ .env לא נכנס ל-git)

# הטוקן מ-@BotFather. חובה.
TELEGRAM_BOT_TOKEN=

# אזור זמן לחישוב תאריכים, תזכורות והסיכום היומי
TZ_NAME=Asia/Jerusalem

# היכן נשמר קובץ הנתונים
DATA_FILE=./data/schoolboost.json

# רמת לוג: debug | info | warn | error
LOG_LEVEL=info

# לשימוש מתקדם בלבד (בדיקות / Bot API server עצמאי)
# TELEGRAM_API_BASE=https://api.telegram.org

# העדפת IPv4 בחיבור לטלגרם. מומלץ להשאיר דלוק —
# IPv6 שבור אצל הספק הוא הסיבה הנפוצה ל-UND_ERR_CONNECT_TIMEOUT.
# PREFER_IPV4=0

# ── מוח ה-AI (אופציונלי) ────────────────────────────────
# בלי מפתח הבוט עובד כרגיל, רק בלי שיחה חופשית עם AI.
# מפתח מ-https://console.anthropic.com
ANTHROPIC_API_KEY=

# AI_MODEL=claude-opus-5
# עומק החשיבה: low | medium | high | xhigh | max
# AI_EFFORT=medium
# יצירת מצגות/אקסל/וורד/PDF. 0 לכיבוי.
# AI_FILES=1

# ── חיבור למייל, יומן, זום וכו' דרך שרת MCP (אופציונלי) ──
# כתובת שרת MCP עם החשבונות המחוברים שלך (למשל Zapier MCP).
# MCP_SERVER_URL=
# MCP_SERVER_NAME=connectors
# MCP_SERVER_TOKEN=
