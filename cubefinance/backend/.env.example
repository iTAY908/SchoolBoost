# Copy to .env. All values optional — the app runs in rule-based fallback
# mode with no key, so nothing here is required to boot.
PORT=4000
CORS_ORIGIN=*
# Leave blank to use the deterministic, data-aware fallback buddy.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5

# ============================================================================
# EMAIL — how the 4-digit verification code reaches the user's real inbox.
# Pick ONE transport.
# ============================================================================

# ---------------------------------------------------------------------------
# Option 1 (default): console — prints the code to the server log, sends
# nothing. Use while developing.
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=console

# ---------------------------------------------------------------------------
# Option 2: SMTP — the most direct route to a real inbox (verified working).
#
# Gmail (easiest, free):
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an App Password → https://myaccount.google.com/apppasswords
#      (a normal Gmail password will NOT work here)
#   3. Uncomment and fill in the five lines below.
#
# Gmail caps sending at roughly 500 messages/day — fine to launch with, but
# move to a transactional provider (Resend / SendGrid / Mailgun) as you grow;
# they handle deliverability, bounces and SPF/DKIM properly.
# ---------------------------------------------------------------------------
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-char-app-password

# ---------------------------------------------------------------------------
# Option 3: Composio — sends through an account you connected in Composio.
# Needs an API key and a connected Gmail (or Loops) account.
# Convenient if you already run Composio; note it adds a network hop and a
# third party to a latency-sensitive signup request.
# ---------------------------------------------------------------------------
# MAIL_TRANSPORT=composio
# COMPOSIO_API_KEY=comp_xxxxxxxxxxxxxxxx
# COMPOSIO_USER_ID=default
# COMPOSIO_MAIL_TOOL=gmail             # gmail | loops
# LOOPS_EVENT_NAME=verification_code   # only when COMPOSIO_MAIL_TOOL=loops

# The From header (SMTP transport).
MAIL_FROM=CubeFinance <no-reply@cubefinance.app>

# Set true ONLY behind a reverse proxy you control, so X-Forwarded-For can be
# trusted for per-IP rate limiting.
TRUST_PROXY=false
